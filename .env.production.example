# HND-062 · Variables de PRODUCCIÓN. Copia a `.env.production` (ignorado por git) y rellena.
# Lo usan:
#   node scripts/cloudflare-secrets.mjs   → sube las variables de servidor al Worker (wrangler secret put)
#   node scripts/supabase-auth-prod.mjs   → configura Supabase Auth (Site URL, Redirect URLs, SMTP)
# Ambos corren en SIMULACIÓN salvo que pases --aplicar. Ninguno imprime valores.

# --- Dominio público (sin https://) ---
DOMINIO_PRODUCCION="handle.mx"

# --- Supabase (servidor del Worker) ---
SUPABASE_PROJECT_ID="tu-project-ref"
SUPABASE_URL="https://tu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# --- Build (NO se suben al Worker: se inyectan al compilar; ponlas en el entorno de `bun run build`
#     o como variables del workflow de deploy) ---
VITE_SUPABASE_PROJECT_ID="tu-project-ref"
VITE_SUPABASE_URL="https://tu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Cobros CoDi ---
# pey = dinero REAL (no hay sandbox). Deja "mock" hasta cerrar el pago real de $0.01.
PAYMENTS_PROVIDER="mock"
PEY_API_KEY=""
PEY_API_URL="https://api.pey.mx"
# El que muestra portal.mipey.mx al crear el webhook a https://<dominio>/api/webhooks/pey
PEY_WEBHOOK_SECRET=""

# --- IA y automatización (opcionales) ---
GROQ_API_KEY=""
GROQ_MODEL=""
N8N_WEBHOOK_URL=""
NOMINATIM_USER_AGENT="handle/1.0 (contacto@handle.mx)"

# --- Supabase Auth (solo scripts/supabase-auth-prod.mjs; no van al Worker) ---
# Token personal: supabase.com/dashboard/account/tokens (puede ir aquí o en el entorno).
SUPABASE_ACCESS_TOKEN=""
# Redirect URLs adicionales, separadas por coma (p. ej. para seguir entrando desde local):
REDIRECT_URLS_EXTRA="http://localhost:8080/auth"
# SMTP propio. Con Resend: host smtp.resend.com, puerto 465, usuario "resend", contraseña = API key.
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""
SMTP_REMITENTE="no-responder@handle.mx"
SMTP_NOMBRE_REMITENTE="Handle"
# Correos de Auth por hora (opcional; Supabase limita a 30/h con SMTP propio por defecto).
SMTP_LIMITE_POR_HORA=""
