# Copia este archivo a `.env` y rellena los valores de tu proyecto Supabase.
# El `.env` real está ignorado por git; este `.example` sí se versiona.

# --- Supabase ---
SUPABASE_PROJECT_ID="tu-project-ref"
SUPABASE_URL="https://tu-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Service role (secreta): Project Settings → API Keys → service_role / secret. NUNCA se expone al cliente.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Variables VITE_* se inyectan en el bundle del cliente (públicas por diseño).
VITE_SUPABASE_PROJECT_ID="tu-project-ref"
VITE_SUPABASE_URL="https://tu-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Cobros CoDi (Fase 3) ---
# mock = simulador local, no mueve dinero (por defecto). pey = API real.
PAYMENTS_PROVIDER="mock"
# API key de portal.mipey.mx → Desarrollador (solo con PAYMENTS_PROVIDER="pey").
PEY_API_KEY=""
PEY_API_URL="https://api.pey.mx"
# Secreto de firma de webhooks (whsec_...). Con Pey real: el que muestra el portal al crear
# el webhook apuntando a https://<tu-dominio>/api/webhooks/pey. En local, cualquier whsec_<base64>.
PEY_WEBHOOK_SECRET="whsec_..."

# --- Mapa (Fase 5) ---
# NOMINATIM_USER_AGENT="handle-pey/1.0 (contacto@tudominio.mx)"

# --- IA (asistente) ---
# console.groq.com → API Keys
GROQ_API_KEY=""
# Opcional; vacío = modelo por defecto del código
GROQ_MODEL=""

# --- Automatización (opcional; vacío = desactivado) ---
N8N_WEBHOOK_URL=""
